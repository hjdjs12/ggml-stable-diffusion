/**
 * @file ggml-cpu-matmul-npu.cpp
 * @brief GGML Matrix Multiplication with NPU Acceleration
 * 
 * This file implements NPU-accelerated matrix multiplication for GGML tensors.
 * It reuses existing GGML quantization functions (from_float, vec_dot_type)
 * and uses the Domain structure from config.hpp for memory management.
 * 
 * Key insights:
 * - src0 = weight tensor (may be Q8_0, Q4_0, FP16, etc.)
 * - src1 = input tensor (typically FP32)
 * - GGML already has from_float() to convert src1 to vec_dot_type (e.g., Q8_0)
 * - NPU needs INT8 format, so we extract Q8_0 data and scales
 */

#include "ggml-cpu.h"
#include "ggml-impl.h"
#include "ggml.h"
#include "ggml-quants.h"
#include "../../rknpu/user-driver/config.hpp"
#include "../../rknpu/user-driver/include/rk-mem.hpp"
#include "../../rknpu/user-driver/include/npu_matmul.h"
#include "../../rknpu/user-driver/include/npu_interface.h"
#include <vector>
#include <memory>
#include <cstring>
#include <cmath>
#include <algorithm>

// ============================================================================
// NPU Constants and Global State
// ============================================================================

// Global NPU state
static bool g_npu_initialized = false;
static int g_npu_fd = -1;

// ============================================================================
// Helper Functions
// ============================================================================

/**
 * @brief 查找 tensor 数据所属的 Domain
 */
static Domain* find_tensor_domain(const void* tensor_data) {
    uint64_t addr = (uint64_t)tensor_data;
    
    for (auto& [handle, domain_ptr] : domain_map) {
        uint64_t va = (uint64_t)domain_ptr->virtual_addr;
        uint64_t len = DOMAIN_SIZE;
        
        if (addr >= va && addr < va + len) {
            return domain_ptr;
        }
    }
    
    return nullptr;
}

/**
 * @brief 获取默认 domain ID
 */
static int get_default_domain_id() {
    if (!domain_map.empty()) {
        return domain_map.begin()->second->id;
    }
    return 0;
}

// ============================================================================
// Q8_0 Format Extraction
// ============================================================================

/**
 * @brief 从 Q8_0  block 格式提取 INT8 数据和 scales
 * 
 * GGML Q8_0 格式：每 32 个元素一组，每组有一个 FP16 scale
 * 
 * @param q8_data Q8_0 block 数据
 * @param M 行数
 * @param K 列数 (must be multiple of 32)
 * @param int8_out 输出 INT8 数据 (M x K)
 * @param scales_out 输出 scale 因子 (M x K/32)
 */
static void extract_q8_0_data(
    const block_q8_0* q8_data,
    int M, int K,
    int8_t* int8_out,
    float* scales_out) {
    
    const int QK8_0 = 32;
    const int nb = K / QK8_0;  // 每行的 block 数
    
    #pragma omp parallel for num_threads(4)
    for (int i = 0; i < M; i++) {
        for (int j = 0; j < nb; j++) {
            const block_q8_0& blk = q8_data[i * nb + j];
            
            // 提取 scale (FP16 -> FP32)
            scales_out[i * nb + j] = GGML_FP16_TO_FP32(blk.d);
            
            // 提取 INT8 数据
            for (int k = 0; k < QK8_0; k++) {
                int8_out[i * K + j * QK8_0 + k] = blk.qs[k];
            }
        }
    }
}

// ============================================================================
// NPU Layout Conversion
// ============================================================================

/**
 * @brief 转换 INT8 数据为 NPU feature layout
 * 
 * NPU 输入布局：使用 feature_data() 函数
 * 
 * @param int8_data 输入 INT8 数据 (M x K, 行优先)
 * @param M 行数
 * @param K 列数
 * @param npu_data 输出 NPU 布局数据
 */
static void convert_to_feature_layout(
    const int8_t* int8_data,
    int M, int K,
    int8_t* npu_data) {
    
    const int K_aligned = (K + 15) & ~15; // 16 字节对齐
    
    // Zero-fill 整个输出缓冲区
    const size_t npu_size = M * K_aligned;
    memset(npu_data, 0, npu_size);
    
    #pragma omp parallel for num_threads(4)
    for (int m = 0; m < M; m++) {
        for (int k = 0; k < K; k++) {
            int npu_idx = feature_data(M, K_aligned, k, m);
            npu_data[npu_idx] = int8_data[m * K + k];
        }
    }
}

/**
 * @brief 转换 INT8 数据为 NPU weight layout
 * 
 * NPU 权重布局：使用 weight_int8() 函数，按 32x32 块组织
 * 
 * @param int8_data 输入 INT8 数据 (N x K，行优先)
 * @param N 输出通道数
 * @param K 输入通道数
 * @param npu_data 输出 NPU 布局数据
 */
static void convert_to_weight_layout(
    const int8_t* int8_data,
    int N, int K,
    int8_t* npu_data) {
    
    const int K_aligned = (K + 31) & ~31; // 32 字节对齐
    
    // Zero-fill 整个输出缓冲区
    const size_t npu_size = N * K_aligned;
    memset(npu_data, 0, npu_size);
    
    #pragma omp parallel for num_threads(4)
    for (int n = 0; n < N; n++) {
        for (int k = 0; k < K; k++) {
            int npu_idx = weight_int8(K_aligned, k, n);
            npu_data[npu_idx] = int8_data[n * K + k];
        }
    }
}

// ============================================================================
// NPU Capability Check
// ============================================================================

/**
 * @brief 检查 tensor 是否可以使用 NPU
 * 
 * 条件：
 * 1. NPU 已初始化
 * 2. 矩阵尺寸适中（太小不值得，太大超限制）
 * 3. src0 类型支持（权重）
 * 4. src1 必须是 FP32（输入会被转换）
 * 5. 内存布局连续
 * 
 * @param src0 权重 tensor
 * @param src1 输入 tensor
 * @return int 1 if 可以使用 NPU, 0 otherwise
 */
int ggml_can_use_npu(const struct ggml_tensor* src0, const struct ggml_tensor* src1) {
    if (!g_npu_initialized) {
        return 0;
    }
    
    // src0: weight(ne01 x ne00), src1: input(ne11 x ne10)
    // 矩阵乘法: (ne01 x ne00) @ (ne11 x ne10)^T = (ne01 x ne11)
    // 其中 ne00 == ne10 (K 维度)
    const int64_t ne00 = src0->ne[0];  // K
    const int64_t ne01 = src0->ne[1];  // M (weight rows)
    const int64_t ne10 = src1->ne[0];  // K
    const int64_t ne11 = src1->ne[1];  // N (input rows)
    
    // 检查维度匹配
    if (ne00 != ne10) {
        return 0;
    }
    
    const int M = ne01;
    const int K = ne00;
    const int N = ne11;
    
    // 小矩阵不值得使用 NPU（开销大于收益）
    if (M < 4 || K < 128 || N < 128) {
        return 0;
    }
    
    // NPU 有最大尺寸限制
    if (M > 65535 || K > 65535 || N > 65535) {
        return 0;
    }
    
    // src1 (输入) 必须是 FP32（会被 from_float 转换）
    if (src1->type != GGML_TYPE_F32) {
        return 0;
    }
    
    // src0 (权重) 类型检查：必须有 vec_dot_type
    const struct ggml_type_traits_cpu* traits = ggml_get_type_traits_cpu(src0->type);
    if (traits->vec_dot_type == GGML_TYPE_COUNT) {
        return 0;  // 不支持的类型
    }
    
    // 只支持 vec_dot_type 为 Q8_0 的情况（NPU 需要 INT8）
    if (traits->vec_dot_type != GGML_TYPE_Q8_0) {
        return 0;
    }
    
    // 检查内存布局（必须连续）
    const size_t nb00 = src0->nb[0];
    const size_t nb10 = src1->nb[0];
    
    if (nb00 != ggml_type_size(src0->type) || nb10 != ggml_type_size(src1->type)) {
        return 0;
    }
    
    return 1;
}

// ============================================================================
// NPU Matrix Multiplication
// ============================================================================

/**
 * @brief NPU 加速的矩阵乘法实现
 * 
 * @param src0 输入矩阵 (M x K)
 * @param src1 权重矩阵 (N x K，需要转置为 K x N)
 * @param dst 输出矩阵 (M x N)
 */
static void compute_matmul_npu_impl(
    const struct ggml_tensor* src0,
    const struct ggml_tensor* src1,
    struct ggml_tensor* dst) {
    
    const int M = src0->ne[1];
    const int K = src0->ne[0];
    const int N = src1->ne[1];
    
    // 获取 domain ID
    Domain* weight_domain = find_tensor_domain(src1->data);
    int domain_id = weight_domain ? weight_domain->id : get_default_domain_id();
    
    // ========================================================================
    // 步骤1：准备输入数据
    // ========================================================================
    
    // 1.1 转换输入到 FP32
    std::vector<float> input_fp32(M * K);
    if (src0->type == GGML_TYPE_Q8_0) {
        dequant_q8_to_fp32(src0, M, K, input_fp32.data());
    } else {
        convert_to_fp32(src0, M, K, input_fp32.data());
    }
    
    // 1.2 量化输入为 INT8
    const int input_groups = (K + NPU_GROUP_SIZE - 1) / NPU_GROUP_SIZE;
    std::vector<int8_t> input_int8(M * K);
    std::vector<float> input_scales(M * input_groups);
    quantize_fp32_to_int8(input_fp32.data(), M, K, 
                          input_int8.data(), input_scales.data(), 
                          NPU_GROUP_SIZE);
    
    // 1.3 转换为 NPU feature layout
    const int K_aligned = (K + 15) & ~15;
    const size_t input_npu_size = M * K_aligned;
    std::vector<int8_t> input_npu(input_npu_size);
    convert_to_feature_layout(input_int8.data(), M, K, input_npu.data());
    
    // ========================================================================
    // 步骤2：准备权重数据
    // ========================================================================
    
    // 2.1 转换权重到 FP32（注意：src1 是 K x N）
    std::vector<float> weight_fp32(N * K);
    if (src1->type == GGML_TYPE_Q8_0) {
        dequant_q8_to_fp32(src1, N, K, weight_fp32.data());
    } else {
        convert_to_fp32(src1, N, K, weight_fp32.data());
    }
    
    // 2.2 量化权重为 INT8
    const int weight_groups = (K + NPU_GROUP_SIZE - 1) / NPU_GROUP_SIZE;
    std::vector<int8_t> weight_int8(N * K);
    std::vector<float> weight_scales(N * weight_groups);
    quantize_fp32_to_int8(weight_fp32.data(), N, K,
                          weight_int8.data(), weight_scales.data(),
                          NPU_GROUP_SIZE);
    
    // 2.3 转换为 NPU weight layout
    const int K_aligned_w = (K + 31) & ~31;
    const size_t weight_npu_size = N * K_aligned_w;
    std::vector<int8_t> weight_npu(weight_npu_size);
    convert_to_weight_layout(weight_int8.data(), N, K, weight_npu.data());
    
    // ========================================================================
    // 步骤3：分配 NPU 内存并传输数据
    // ========================================================================
    
    // 使用 Memory 类分配 NPU 可访问的内存
    Memory input_mem(input_npu_size, 0, domain_id);
    memcpy(input_mem.va, input_npu.data(), input_npu_size);
    
    Memory weight_mem(weight_npu_size, 0, domain_id);
    memcpy(weight_mem.va, weight_npu.data(), weight_npu_size);
    
    const size_t output_npu_size = M * N * sizeof(int32_t); // NPU 输出 INT32
    Memory output_mem(output_npu_size, 0, domain_id);
    
    // 分配命令缓冲区
    const size_t cmd_size = NPU_REGS_SIZE * sizeof(uint64_t);
    Memory cmd_mem(cmd_size, 0, domain_id);
    
    // ========================================================================
    // 步骤4：生成 NPU 命令
    // ========================================================================
    
    matmul_params_t params;
    params.m = M;
    params.k = K;
    params.n = N;
    params.tasks = (uint64_t*)cmd_mem.va;
    
    int ret = gen_matmul_int8(&params);
    if (ret != 0) {
        fprintf(stderr, "[NPU] gen_matmul_int8 failed: %d\n", ret);
        throw std::runtime_error("NPU command generation failed");
    }
    
    // 更新地址
    update_matmul_addr((uint64_t*)cmd_mem.va, 
                       (uint32_t)input_mem.dma,
                       (uint32_t)weight_mem.dma,
                       (uint32_t)output_mem.dma);
    
    // ========================================================================
    // 步骤5：提交 NPU 任务
    // ========================================================================
    
    struct rknpu_submit submit{};
    submit.flags = 0;
    submit.timeout = 5000; // 5 秒超时
    submit.task_start = 0;
    submit.task_number = 1;
    submit.task_counter = 1;
    submit.priority = 0;
    submit.task_obj_addr = cmd_mem.obj;
    submit.iommu_domain_id = domain_id;
    submit.task_base_addr = cmd_mem.dma;
    submit.core_mask = 0x7; // 使用所有核心
    submit.fence_fd = -1;
    
    ret = ioctl(g_npu_fd, DRM_IOCTL_RKNPU_SUBMIT, &submit);
    if (ret < 0) {
        fprintf(stderr, "[NPU] ioctl SUBMIT failed: %d, errno=%d (%s)\n", 
                ret, errno, strerror(errno));
        throw std::runtime_error("NPU submit failed");
    }
    
    // ========================================================================
    // 步骤6：读取结果并反量化
    // ========================================================================
    
    // NPU 输出是 INT32，需要应用 scale 转回 FP32
    // output_fp32[i][j] = sum_k(input_i8[i][k] * weight_i8[j][k]) * scale
    //                   = sum_k((input[i][k]/in_s[i][g_k]) * (weight[j][k]/w_s[j][g_k])) * in_s * w_s
    //                   = sum_k(input[i][k] * weight[j][k] / (in_s[i][g_k] * w_s[j][g_k])) * in_s * w_s
    // 简化：每个位置的 scale = input_scale * weight_scale（按 group）
    
    const int32_t* output_int32 = (const int32_t*)output_mem.va;
    float* dst_data = (float*)dst->data;
    
    #pragma omp parallel for num_threads(4)
    for (int i = 0; i < M; i++) {
        for (int j = 0; j < N; j++) {
            // 累加每个 group 的贡献
            float result = 0.0f;
            
            for (int g = 0; g < input_groups && g < weight_groups; g++) {
                // 计算这个 group 对应的 k 范围
                int k_start = g * NPU_GROUP_SIZE;
                int k_end = std::min(k_start + NPU_GROUP_SIZE, K);
                
                // 这个 group 的 scale
                float in_scale = input_scales[i * input_groups + g];
                float w_scale = weight_scales[j * weight_groups + g];
                float combined = in_scale * w_scale;
                
                // 累加这个 group 的贡献（近似）
                // 注意：NPU 输出的 INT32 已经是所有 k 的累加和，不是按 group 分开的
                // 所以这里的处理需要根据实际 NPU 输出格式调整
                result += output_int32[i * N + j] * combined / input_groups;
            }
            
            dst_data[i * N + j] = result;
        }
    }
}

// ============================================================================
// Main Entry Point
// ============================================================================

/**
 * @brief NPU 加速的 GGML 矩阵乘法（C 接口）
 * 
 * @param params 计算参数
 * @param dst 输出 tensor
 */
void ggml_compute_forward_mul_mat_npu(
    const struct ggml_compute_params* params,
    struct ggml_tensor* dst) {
    
    const struct ggml_tensor* src0 = dst->src[0];
    const struct ggml_tensor* src1 = dst->src[1];
    
    // 只在第一个线程执行（NPU 不需要多线程）
    if (params->ith != 0) {
        return;
    }
    
    try {
        // 调用 NPU 实现
        compute_matmul_npu_impl(src0, src1, dst);
    } catch (const std::exception& e) {
        // NPU 失败，回退到 CPU
        fprintf(stderr, "[NPU] Error: %s, falling back to CPU\n", e.what());
        // 注意：这里应该调用原始的 CPU 实现，但由于架构限制，
        // 我们只能抛出异常让调用者处理
        throw;
    }
}

/**
 * @brief 初始化 NPU 子系统
 * 
 * 应在程序启动时调用
 */
void ggml_npu_init() {
    if (g_npu_initialized) {
        return;
    }
    
    // 打开 NPU 设备
    g_npu_fd = npu_open();
    if (g_npu_fd < 0) {
        fprintf(stderr, "[NPU] Failed to open NPU device: %d\n", g_npu_fd);
        return;
    }
    
    // 重置 NPU
    int ret = npu_reset(g_npu_fd);
    if (ret < 0) {
        fprintf(stderr, "[NPU] Failed to reset NPU: %d\n", ret);
        npu_close(g_npu_fd);
        g_npu_fd = -1;
        return;
    }
    
    g_npu_initialized = true;
    printf("[NPU] NPU initialized successfully (fd=%d)\n", g_npu_fd);
}

/**
 * @brief 释放 NPU 资源
 * 
 * 应在程序退出时调用
 */
void ggml_npu_free() {
    if (!g_npu_initialized) {
        return;
    }
    
    if (g_npu_fd >= 0) {
        npu_close(g_npu_fd);
        g_npu_fd = -1;
    }
    
    g_npu_initialized = false;
    printf("[NPU] NPU resources freed\n");
}
